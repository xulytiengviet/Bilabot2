{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh-edge",
  "main": "src/index.ts",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "minify": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/login",
      "/public",
      "/owner",
      "/public/*",
      "/.env",
      "/.git/config",
      "/wp-admin",
      "/wp-admin/",
      "/wp-login.php",
      "/xmlrpc.php",
      "/phpmyadmin",
      "/phpmyadmin/",
      "/admin-secret-panel"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DSH_EDGE_INSTANCE",
        "class_name": "DshEdgeInstance"
      },
      {
        "name": "PUBLIC_VISITOR_QUOTA",
        "class_name": "PublicVisitorQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DshEdgeInstance"
      ]
    },
    {
      "tag": "v2-public-visitor-quota",
      "new_sqlite_classes": [
        "PublicVisitorQuota"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "env": {
    "isolated": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DSH_EDGE_INSTANCE",
            "class_name": "DshEdgeInstance"
          },
          {
            "name": "PUBLIC_VISITOR_QUOTA",
            "class_name": "PublicVisitorQuota"
          }
        ]
      },
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "vars": {
        "DSH_EDGE_PUBLIC_CHAT": "enabled",
        "DSH_EDGE_PUBLIC_MAX_TOKENS": "1024",
        "WORKERS_AI_MODEL": "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b"
      },
      "ratelimits": [
        {
          "name": "PUBLIC_CHAT_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "observability": {
        "enabled": false
      },
      "ai": {
        "binding": "AI"
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "DshEdgeInstance"
          ]
        },
        {
          "tag": "v2-public-visitor-quota",
          "new_sqlite_classes": [
            "PublicVisitorQuota"
          ]
        }
      ]
    },
    "container": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DSH_EDGE_INSTANCE",
            "class_name": "DshEdgeInstance"
          },
          {
            "name": "PUBLIC_VISITOR_QUOTA",
            "class_name": "PublicVisitorQuota"
          }
        ]
      },
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "vars": {
        "DSH_EDGE_CONTAINER_RUNTIME": "enabled",
        "DSH_EDGE_PUBLIC_CHAT": "enabled",
        "DSH_EDGE_PUBLIC_MAX_TOKENS": "1024",
        "WORKERS_AI_MODEL": "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b"
      },
      "containers": [
        {
          "class_name": "DshEdgeInstance",
          "image": "./container/Dockerfile",
          "instance_type": "basic",
          "max_instances": 1,
          "rollout_active_grace_period": 0,
          "rollout_step_percentage": [
            100
          ]
        }
      ],
      "ratelimits": [
        {
          "name": "PUBLIC_CHAT_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "observability": {
        "enabled": false
      },
      "ai": {
        "binding": "AI"
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "DshEdgeInstance"
          ]
        },
        {
          "tag": "v2-public-visitor-quota",
          "new_sqlite_classes": [
            "PublicVisitorQuota"
          ]
        }
      ]
    }
  },
  "vars": {
    "DSH_EDGE_PUBLIC_CHAT": "enabled",
    "DSH_EDGE_PUBLIC_MAX_TOKENS": "1024",
    "WORKERS_AI_MODEL": "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
